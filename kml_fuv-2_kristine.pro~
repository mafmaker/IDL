	Pro  Line_KML,  File_Unit, Line, NAME=Name, Color=Color, Width=Width, S_TIME=s_time, E_TIME=e_time, TIME=Time
;===============================================================================
;	
;	Google Earth "Line" output for Given Line (3, *)
