;===============================================================================
;
;	Example of Map_KML
;
;===============================================================================
;----- Date -----
;Year=2004
;Month=10
;Day=29

;----- Array size -----



for j = 0, 1 do begin

  if j eq 0 then begin
    filelist=findfile("./s12*map")
    loadct, 1
  endif

  if j eq 1 then begin
    filelist=findfile("./s13*map")
    loadct, 8
  endif

  yearlist=strmid(filelist,5,4)
  daylist=strmid(filelist,9,3)
  hourlist=strmid(filelist,12,2)
  minutelist=strmid(filelist,14,2)

  for iyear=2000,2005 do begin
    for iday=0,365 do begin
      timefinder=where(fix(yearlist) eq iyear and fix(daylist) eq iday,found)
      if found gt 0 then begin


        syear=strcompress(iyear,/rem)
        ydn2md,iyear,iday,month,dom
        smonth=strcompress(month,/rem) & if month lt 10 then smonth='0'+smonth
        sday=strcompress(iday, /rem) & if iday lt 100 then sday='0' + sday
                               if iday lt 10 then sday='0' + sday
        sdom=strcompress(dom, /rem) & if dom lt 10 then sdom='0' + sdom

        Num_Time=n_elements(filelist)

        Num_Time=found

        min_lat_arr=fltarr(Num_Time)
        max_lat_arr=fltarr(Num_Time)
        max_lon_arr=fltarr(Num_Time) + 180.
        min_lon_arr=fltarr(Num_Time) - 180.

        restore,filelist(timefinder(0)) 
	
        Sizer=size(mapim) & Timer=Map_Time(1)/1000.d
        Start_Hour=fix(Timer/3600.d)
        Start_Minute=fix((Timer/3600.d - Start_Hour) * 60.d)

        ;if mean([maxlat,minlat]) lt 90 then Hemisphere='South' else $
        ;  Hemisphere='North'

        Num_Lon=Sizer(1)   ;this won't change
        Num_Lat=180. / lat_res

        ;data_array=fltarr(Num_Lon,Num_Lat)

        ; Time in hours
;        Time=findgen(Num_Time)*2./60.   + Start_Hour + Start_Minute/60.
	Time=float(hourlist) + float(minutelist)/60.
	
        MAP_Data=fltarr(Num_Time, Num_Lon, Num_Lat+1) -1

        ;stop

        ;----- Set plot map array -----
        Max_Latsize=0
        for I_Time=0, Num_Time-1 do begin
          ;  data_array(*,*)=-1
          restore,filelist(timefinder(I_Time))
          max_lat_arr(I_Time)=maxlat-90
          min_lat_arr(I_Time)=minlat-90 ;;
          ;  stop

          Find_Latsize=size(mapim)
          ;  Max_Latsize=Max_Latsize > Find_Latsize(2)

          ;--- Northern Pole put at 0 Latitude ---

          ;  If hemisphere eq 'North' then map_array=reverse(mapim,2) else $
          ;	map_array=mapim
          ;  map_bottom=(round(minlat)/latres) ;this round is maybe not
          ;     necessary
          map_bottom=((minlat)/lat_res) ;this round is maybe not necessary
          Map_Data(I_Time,*,0+map_bottom:Find_Latsize(2)-1 + map_bottom  )=mapim

        endfor

        ;--- Delete unused portions of Map_Data ----

        ;Map_Data=Map_Data(*,*,0:Max_Latsize-1)

        ;---- If necessary, reverse the data so north is up again ----

        ;if Hemisphere eq 'North' then $
        ;Map_Data=reverse(Map_Data,3) 

        ;----- Shift Longitude -----
        Map_Data=shift(Map_Data, 0, Num_Lon/2., 0)

        ;----- Location of map -----

        ;if Hemisphere eq 'North' then begin
        ;  Min_Lat=90. - Max_Latsize * lat_res
        ;  Max_Lat=90. 
        ;endif else begin
        ;  Min_Lat=-90.
        ;  Max_Lat=-90 + Max_Latsize * lat_res
        ;endelse

        Min_Lat = -90
        Max_Lat =  90

        Min_Lon=-180.
        Max_Lon=180. 
        Alt=200.

        ;----- Plot parameters, values in Instrument Counts -----
;        if j eq 0 then max_v=40. else max_v=50.

        max_v=40.
        min_v=0.
        Map_Data=Map_Data > 0   ;crucial for funny flatfield effects

        BAD_DATA=-1

        if j eq 0 then Name='IMAGE SI-12' else Name='IMAGE SI-13'
        Transparency='66'

        ;----- Make images directory -----
        spawn,'ls fuv_data',dircount
        if n_elements(dircount) gt 1 then spawn,'rm -f fuv_data/*' else $
          spawn,'mkdir fuv_data'


        ;----- Create color bar

        set_plot,'z'
        erase
        cbar_xsize=300 & cbar_ysize=100
        if j eq 0 then cbar_annotation='SI-12 Counts' else $
	  cbar_annotation='SI-13 Counts'

        device,set_resolution=[cbar_xsize,cbar_ysize]
	dummy_min_v=min_v 
        cbar,[.1,.7,.9,.9],dummy_min_v+1,max_v,cbar_annotation,1.5,/horiz,numticks=3,color_=250

        a=tvread()
        tvlct,r,g,b,/get
        write_png,'fuv_data/cbar.png',a,r,g,b
        set_plot,'X'


        ;-----



        ;----- Make Images & KML file -----
        if j eq 0 then sinstrument = 'si12_' else sinstrument = 'si13_'
        outfilebase = sinstrument + syear + '_' + smonth + '_' + sdom
        I_err=Open_KML( outfilebase+'.kml', KML_Unit)

;        stop

	print,min_v

        Map_KML, KML_Unit, iYear, Month, Dom, Time, Min_Lat, Max_Lat, Min_Lon, Max_Lon, Alt, Map_Data, Min_V=Min_V, Max_V=Max_V, BAD_DATA=BAD_DATA, Transparency=transparency, Name=Name

        Cbar_KML, KML_Unit, cbar_xsize,cbar_ysize

        Close_KML,  KML_Unit


        ;----- Zip -----

        spawn, 'rm -f '+outfilebase+'.kmz'
        spawn, '~/dagik/convert.sh'
        spawn, 'zip '+outfilebase+'.kmz '+outfilebase+'.kml fuv_data/*png'




        ;  spawn,'zip ' + outfilename + ' fuv.kml fuv_data/*png'

        ;---------------

      endif

    endfor

  endfor

endfor




