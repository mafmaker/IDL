PRO THETAROT,NEWS,NEWd,NEWZ,NEWS2,NEWD2,NEWZ2,ZLAT

;PROGRAM TO ROTATE VECTORS ABOUT Y-AXIS

;print,newd

THETA=ABS((!PI/2.0)-ZLAT)
ROTYAX=FLTARR(3,3)
ROTYAX(0:2,0)=[COS(THETA),0,-SIN(THETA)]
ROTYAX(0:2,1)=[0,1,0]
ROTYAX(0:2,2)=[SIN(THETA),0,COS(THETA)]
NEWS2=[NEWS(0),NEWS(1),NEWS(2)]#ROTYAX
NEWD2=[NEWD(0),NEWD(1),NEWD(2)]#ROTYAX
NEWZ2=[NEWZ(0),NEWZ(1),NEWZ(2)]#ROTYAX


RETURN
end
