
pro load_dmsp,sat,year,startday,stopday

;program to load dmsp data into the dmsp common block for access by
;other procedures. to be loaded are
;IDL> print,headline
;0 Date 
;1 Time 
;2 R
;3 I
;4 Alt.
;5 GLAT
;6 GLONG
;7 MLAT
;8 MLT
;9 Vx
;10 Vy
;11 Vz
;12 RMSx
;13 SigmaY
;14 SigmaZ
;15 Ni (cm^-3)
;16 Frac O
;17 Frac He
;18 Frac H
;19 Ti
;20 Te
;21 pts



COMMON dmsp, dmsp_struct

; holder arrays are defined, with sizes based upon how many days of data

for i=0,stopday-startday do begin

  sc = strlowcase(sat) + '_rl'

  if year gt 1000 then year_=(year-1900) mod 100 else year_=year
  if year_ lt 1 then syear='00'
  if year_ lt 10 then syear='0' + strcompress(year_,/rem)
  if year_ ge 10 then syear=strcompress(year_,/rem)
  sday=strcompress(startday + i,/rem)
  if startday lt 100 then sday = '0' + sday 
  if startday lt 10 then sday  = '0' + sday

  ffilter=sc+syear+sday + '*.txt'
  pfilter='./data_txt_files/'

;--- make sure you aren't adding empty strings to the file list.

  test=findfile(pfilter+ffilter)
  if test(0) ne '' then begin
    if defined(filelist) eq 0 then $
      filelist=findfile('./data_txt_files/'+ffilter) else $
      filelist=[filelist, findfile('./data_txt_files/'+ffilter)]
  endif

endfor

holder=(1600 * n_elements(filelist))

dater=fltarr(22,holder)

counter=0

for i=0,n_elements(filelist)-1 do begin

;--- gotta get past the header
  startread=strarr(1)
  get_lun,unit
  openr,unit,filelist(i)
  print,'Reading ',filelist(i)
  header=1
  while header eq 1 do begin
    readf,unit,startread 
    headline=strsplit(startread,/extract)
;    print,headline(0)
    if strcompress(headline(0),/rem) eq 'Date' then header = 0
;    help,startread,headline
  endwhile

;-- NOW read all that data
  bla=fltarr(22)

  while not(eof(unit)) do begin
    readf,unit,bla
;    print,bla
    dater(*,counter)=bla
    counter=counter+1
  endwhile

  close,/all

endfor

dater=dater(*,0:counter-1)

dmsp_struct={date:fix(dater(0,*) mod 1000),$
             time:dater(1,*),$
             RR:dater(2,*),$
             II:dater(3,*),$
             alt:dater(4,*),$
             glat:dater(5,*),$
             glon:dater(6,*),$
             mlat:dater(7,*),$
             mlt:dater(8,*),$
             vx:dater(9,*),$
             vy:dater(10,*),$
             vz:dater(11,*),$
             rmsx:dater(12,*),$
             sigmay:dater(13,*),$
             sigmaz:dater(14,*),$
             Ni:dater(15,*),$
             frac_O:dater(16,*),$
             frac_He:dater(17,*),$
             frac_H:dater(18,*),$
             Ti:dater(19,*),$
             Te:dater(20,*),$
             pts:dater(21,*)}


stop

end
